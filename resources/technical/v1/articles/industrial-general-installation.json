    {
      "type": "heading",
      "level": 2,
      "text": "Maximum Installation Tension"
    },
    {
      "type": "paragraph",
      "body": "To calculate the maximum allowable tension of cables during installation the following formula should be applied:"
    },
    {
      "type": "paragraph",
      "body": "50 × C × Nc"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "C = cross section area of conductor in mm²",
        "Nc = total number of cores"
      ]
    },
    {
      "type": "note",
      "tone": "warning",
      "body": "Maximum tension must not exceed 20,000 N (kg = N / 9.81)."
    }
  ],
