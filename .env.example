APP_ENV=development
APP_NAME=tricab-api
APP_DEBUG=true

# Development authentication (never enable in production)
DEV_AUTH_ENABLED=true
DEV_AUTH_DEFAULT_TENANT=development-tenant
DEV_AUTH_DEFAULT_SUBJECT=development-thilan
DEV_AUTH_DEFAULT_EMAIL=thilanh@tricab.com

# User repository: memory | azure-sql
USER_REPOSITORY=memory

# Database auth: sql-login | entra-cli | managed-identity
# Local development: entra-cli (uses `az account get-access-token`).
# Azure App Service: managed-identity (IDENTITY_ENDPOINT / IMDS; do not use entra-cli).
# sql-login only when explicitly required, with DB_USERNAME / DB_PASSWORD (not a Microsoft 365 password).
# Unknown values are rejected; there is no silent fallback to sql-login.
DB_AUTH_MODE=entra-cli

# Request PDO/SQL timing logs (default true in development, false in production)
# APP_PERFORMANCE_LOGGING=true
# APP_PERFORMANCE_SQL_VERBOSE=false

# Cross-request cache: apcu | file | array
# Default: apcu if usable, otherwise file (var/cache/app). array is request-scoped (tests).
# APP_CACHE_DRIVER=file
# APP_CACHE_PATH=var/cache/app

# Azure SQL serverless resume: LoginTimeout (seconds) + at most one PDO connect retry.
# Does not retry SQL queries. Does not keep the database awake.
# DB_LOGIN_TIMEOUT_SECONDS=20
# DB_CONNECT_RETRY_ENABLED=true
# DB_CONNECT_RETRY_MAX_ATTEMPTS=2
# DB_CONNECT_RETRY_DELAY_MS=1500

# Azure SQL (required when USER_REPOSITORY=azure-sql)
DB_DRIVER=sqlsrv
DB_HOST=tricab-mel.database.windows.net
DB_PORT=1433
DB_DATABASE=tc
# Used only when DB_AUTH_MODE=sql-login — do not set these for entra-cli or managed-identity.
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

# Microsoft Entra access-token validation
ENTRA_TENANT_ID=f0ec33ca-6286-41fd-a659-e288f9934dda
ENTRA_CLIENT_ID=<API_APPLICATION_CLIENT_ID>
ENTRA_AUDIENCE=api://<API_APPLICATION_CLIENT_ID>
ENTRA_REQUIRED_SCOPE=access_as_user
# Stable directory mapping: oid (preferred) or sub — do not mix in the database
ENTRA_SUBJECT_CLAIM=oid

# Google Sign-In (OIDC ID token audience). Required for POST /api/v1/auth/google.
# Must match the SPA OAuth client ID (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Additive native audiences for mobile ID tokens (iOS bundle / Android package clients).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple Sign-In (Services ID + Sign in with Apple key). Required for GET/POST /api/v1/auth/apple*.
# APPLE_PRIVATE_KEY may be an inline PEM with escaped \n, or file:///absolute/path/to/AuthKey_XXXXX.p8
APPLE_CLIENT_ID=
# Native Sign in with Apple audience (app bundle). Default com.tricab.TriCab. Powers POST /api/v1/auth/apple/native.
APPLE_NATIVE_CLIENT_ID=com.tricab.TriCab
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# React SPA origins (comma-separated). Never use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Guest OTP email delivery: development | postmark | microsoft-graph
# production must not use development (rejected by Settings).
GUEST_EMAIL_PROVIDER=development
# Opt-in only. Writes the OTP to STDERR for local debugging. Never enable in production.
GUEST_OTP_DEV_REVEAL=false

POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=TriCab
POSTMARK_MESSAGE_STREAM=outbound

# Microsoft Graph mail (when GUEST_EMAIL_PROVIDER=microsoft-graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
RFQ_MAILBOX=
# Optional hosted logo URL for OTP emails (https://...). Leave blank for embedded TriCab mark.
GUEST_OTP_EMAIL_LOGO_URL=

# Guest access tokens (HS256). Required when USER_REPOSITORY=azure-sql.
# Generate: php -r "echo base64_encode(random_bytes(64)), PHP_EOL;"
GUEST_JWT_ISSUER=https://api.tricab.local
GUEST_JWT_AUDIENCE=tricab-api
GUEST_JWT_SECRET=
GUEST_JWT_TTL_SECONDS=86400
GUEST_JWT_CLOCK_SKEW_SECONDS=30

# Trusted-device biometric return login credential TTL (days). Access JWT stays 24h.
TRUSTED_DEVICE_TTL_DAYS=90

# Guest passkeys (WebAuthn). Development defaults PASSKEY_ENABLED=true.
# Production must use exactly:
#   PASSKEY_ENABLED=true
#   PASSKEY_RP_ID=tricab.com
#   PASSKEY_ALLOWED_ORIGINS=https://www.tricab.com,https://tricab.com
#   PASSKEY_PUBLIC_APP_BASE_URL=https://www.tricab.com
# Never set production RP ID to localhost, *.azurewebsites.net, a slot host, or a subdomain.
# PASSKEY_FAKE_CEREMONY=true is for in-memory HTTP tests only and is ignored on Azure SQL.
PASSKEY_ENABLED=true
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=TriCab
PASSKEY_ALLOWED_ORIGINS=http://localhost:5173
PASSKEY_PUBLIC_APP_BASE_URL=http://localhost:5173
PASSKEY_SETUP_TOKEN_TTL_SECONDS=900
PASSKEY_REGISTRATION_CHALLENGE_TTL_SECONDS=300
PASSKEY_AUTH_CHALLENGE_TTL_SECONDS=300
PASSKEY_FAKE_CEREMONY=false

# Optional gated integration suite
RUN_AZURE_SQL_INTEGRATION_TESTS=false
RUN_AZURE_INTEGRATION_TESTS=false

# ---------------------------------------------------------------------------
# Product assistant / Azure Foundry
# Keep disabled until an endpoint, deployment, and production identity are approved.
# The SPA must never receive these credentials.
# ---------------------------------------------------------------------------
FOUNDRY_ENABLED=true
FOUNDRY_ENDPOINT=https://tricab-ai2.services.ai.azure.com
FOUNDRY_MODEL_DEPLOYMENT=claude-sonnet-5-5
# managed-identity (production) | api-key (development only)
# Settings.php refuses api-key when APP_ENV=production, so the App Service needs its
# system-assigned identity (present on the tc-web/core slot) to hold an Azure AI role on
# tricab-ai2. Locally, set api-key plus FOUNDRY_API_KEY, or leave managed-identity and the
# assistant degrades to DeterministicAssistantResponseProvider via the fallback wrapper.
FOUNDRY_AUTH_MODE=managed-identity
FOUNDRY_API_KEY=
FOUNDRY_TIMEOUT_SECONDS=30
FOUNDRY_MAX_TOOL_CALLS=5
# Whole-turn budget (5-300 s) across all model calls and tools. Past it the assistant stops using tools and
# answers with what it has. Keep it above a typical slow turn (20-30 s).
FOUNDRY_TURN_DEADLINE_SECONDS=45
# Effort for every Foundry Claude call (assistant and Log Note summaries): low|medium|high|xhigh|max.
# Empty sends none. Claude Sonnet 5.5 thinks by default (effort high) when none is sent, which is slow
# for chat; start at low there and measure.
FOUNDRY_EFFORT=low

# ---------------------------------------------------------------------------
# CableFit research agent (C3): advisory web research for a candidate design, run by the
# cablefit-research WebJob (docs/runbooks/cablefit-research.md). Off by default; a request while off is
# a 503 CABLEFIT_RESEARCH_OFF. Uses the Foundry connection above (the web search tool must be allowed on
# the deployment). Only domains in [cablefit].research_sources are searched and cited.
# ---------------------------------------------------------------------------
CABLEFIT_RESEARCH_ENABLED=false
CABLEFIT_RESEARCH_MODEL=claude-sonnet-5-5
CABLEFIT_RESEARCH_MAX_SEARCHES=8
# Runs one user may start in a rolling 24 hours, any status (1-100). Over it: 429 CABLEFIT_RESEARCH_DAILY_LIMIT.
CABLEFIT_RESEARCH_DAILY_RUNS_PER_USER=10
# Whole research exchange, seconds (30-900).
CABLEFIT_RESEARCH_TIMEOUT_SECONDS=300
# Longest gap between database looks while idle, minutes: a lost wake-up is found after this long.
CABLEFIT_RESEARCH_IDLE_CHECK_MINUTES=1440
# Where requests leave word for the worker (relative to the app root); web app and WebJob must share it.
CABLEFIT_RESEARCH_WAKE_PATH=var/cablefit-research

# ---------------------------------------------------------------------------
# Phase 13.7B — Legacy Cost API (server-side only; browser must never call)
# ---------------------------------------------------------------------------
LEGACY_COST_API_ENABLED=false
LEGACY_COST_API_URL=https://www.tricab.com/cost-api/
LEGACY_COST_API_TIMEOUT_SECONDS=8
# Non-production runtime cost source: legacy-cost-api | legacy-fallback | azure-first
# When unset in development, defaults to legacy-cost-api when LEGACY_COST_API_ENABLED=true
PRICING_COST_SOURCE=legacy-cost-api
# Automatic TMMKTM when no style/territory/market rule matches. 0 = sell at Cost API cost.
# Empty disables the fallback and keeps Price TBC.
PRICING_DEFAULT_TMMKTM_MARGIN=0

# ---------------------------------------------------------------------------
# Phase 9 — Product Azure Blob Storage (never commit real account keys)
# BLOB_AUTH_MODE: disabled | memory | connection-string
#   memory            — in-process store for local/API tests (not for production)
#   connection-string — Azurite or disposable non-prod storage account
#   disabled          — upload session endpoints reject with 503 STORAGE_UNAVAILABLE
# Production: use connection-string only until Managed Identity SAS is enabled;
#             BLOB_AUTH_MODE=memory is rejected when APP_ENV=production.
# ---------------------------------------------------------------------------
BLOB_AUTH_MODE=memory
BLOB_CONNECTION_STRING=
BLOB_ACCOUNT_NAME=
BLOB_ACCOUNT_KEY=
BLOB_ENDPOINT=
BLOB_CONTAINER_PRODUCTS=products
BLOB_CONTAINER_TRIEXPENSE=triexpense
# Generated onboarding documents (completed forms). Private container; never public.
BLOB_CONTAINER_ONBOARDING=onboarding
# Finance files (F1.9), for all five finance apps. Private container; never public. Created by hand.
BLOB_CONTAINER_FINANCE=finance-attachments
# Optional CDN / Front Door base (https://cdn.example.com) — no trailing slash
BLOB_CDN_BASE_URL=
# auto-clean (dev) | pending-scan | defender (document Microsoft Defender for Storage)
BLOB_SCAN_MODE=auto-clean
BLOB_UPLOAD_SAS_TTL_SECONDS=900
BLOB_DOWNLOAD_SAS_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Product 3D Studio
# ---------------------------------------------------------------------------
PRODUCT_3D_ENABLED=true
PRODUCT_3D_PROVIDER=disabled
PRODUCT_3D_GENERATION_ENABLED=false


# Legacy product migration — STRICT READ-ONLY MySQL (never write)
# Prefer a MySQL user with SELECT-only grants on WordPress/tc schemas.
LEGACY_WP_DSN=mysql:host=127.0.0.1;port=3306;dbname=wordpress;charset=utf8mb4
LEGACY_WP_USER=readonly_user
LEGACY_WP_PASSWORD=
LEGACY_WP_TABLE_PREFIX=wp_
LEGACY_WP_SSL_MODE=required
LEGACY_WP_READ_ONLY=true
LEGACY_TC_DSN=mysql:host=127.0.0.1;port=3306;dbname=tc;charset=utf8mb4
LEGACY_TC_USER=readonly_user
LEGACY_TC_PASSWORD=
LEGACY_TC_SSL_MODE=required
LEGACY_TC_READ_ONLY=true
# Temporary development-only override: permits read extraction when MySQL grants
# include write privileges. Requires APP_ENV=development and LEGACY_*_READ_ONLY=true.
# Must remain false in staging and production.
LEGACY_MIGRATION_ALLOW_WRITE_CAPABLE_READER=false
# Legacy migration persistence: memory (process-local) | azure-sql
# LEGACY_MIGRATION_STORE=memory
# LEGACY_WP_HOST=
# LEGACY_WP_PORT=3306
# LEGACY_WP_DATABASE=tricab
# LEGACY_TC_HOST=
# LEGACY_TC_PORT=3306
# LEGACY_TC_DATABASE=tc
LEGACY_FILES_ROOT=
LEGACY_SOURCE_WAIVE_WP=false
LEGACY_SOURCE_WAIVE_TC=false
LEGACY_SOURCE_WAIVE_FILES=false
PHASE12_PILOT_APPROVED=true

# ---------------------------------------------------------------------------
# Cable calculator
# ---------------------------------------------------------------------------
# native    — NativeCableCalculatorEngine, in-process, reads the SHA-256 pinned
#             JSON snapshots in resources/cable-calculator/v1. This is the default.
# legacy-cli — proc_open()s tc-web/tools/legacy-cable-calculator/calculate-json.php
#             on every request. Kept only for parity re-verification; that script is
#             not present on the App Service.
CABLE_CALCULATOR_ENGINE=native
# CABLE_CALCULATOR_DATASET_DIR=

# ---------------------------------------------------------------------------
# Product finder (Phase 3) — the Python selection rules at core/python/
# ---------------------------------------------------------------------------
# The finder runs as a persistent process inside the same App Service and PHP
# proxies to it; there is no nginx location for it, so catalogue visibility
# stays enforced in PHP. The base URL must stay on the loopback interface —
# Settings::from() refuses to boot otherwise — because that process has no
# authentication of its own.
#
# Off by default. With it off, POST /api/v1/product-finder answers 200 with
# `status: unavailable`, the same shape an unreachable service produces, so
# there is one degraded path rather than three.
#
# Local development: run the finder yourself first —
#   cd core/python && PYTHONPATH=. python -m flask --app product_finder.app run --port 8001
PRODUCT_FINDER_ENABLED=false
PRODUCT_FINDER_BASE_URL=http://127.0.0.1:8001
PRODUCT_FINDER_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# RFQ module
# ---------------------------------------------------------------------------
# The module is always on; access is by RFQ.* permission. The parser is
# switched separately (RFQ_PARSER_ENABLED, with a token).
#
# Sync to 4js (parity plan E7.3). THIS GUARDS A WRITE TO THE PRODUCTION 4js ERP,
# so it is the one RFQ switch that exists, a deliberate exception to removing
# RFQ_MODULE_ENABLED (that one was only a display switch). Off by default; ONLY
# the exact text `true` turns it on ("1", "yes", "on" and "TRUE" do not). While
# off, the editor draws Sync to 4js disabled with the reason and the API answers
# 503 RFQ_SYNC_DISABLED without reading or sending anything. Turning it on is not
# enough to reach 4js: no live 4js adapter is wired in this repository, so a sync
# then answers 503 RFQ_SYNC_UNAVAILABLE. The old tc-web app remains the
# production quote owner during the pilot; the owner decides when this changes.
RFQ_SYNC_ENABLED=false

# ---------------------------------------------------------------------------
# Customer Contact reports (the complaint register)
# ---------------------------------------------------------------------------
# Off by default, same as RFQ. Off: /api/v1/customer-contacts is not registered.
# This is not the customer-person API at /api/v1/admin/customer-contacts.
# /api/v1/me reports modules.customerContacts only when this is on AND the
# caller holds CUSTOMER_CONTACT.ACCESS. READ_ALL is not granted to employees.
CUSTOMER_CONTACT_MODULE_ENABLED=false
# Staff login (work email) that receives the credit-note settlement task.
# Empty until Accounts is named in deployment configuration. A credit cannot
# be approved while this is empty. Do not put a person's login here by default.
CUSTOMER_CONTACT_ACCOUNTS_LOGIN=
# Work email of the quality coordinator who receives new-report and completion
# mail. Empty until that person is named. No mail is sent to a guessed address.
CUSTOMER_CONTACT_COORDINATOR_LOGIN=
# Optional shared Accounts mailbox copied on an approved credit, in addition
# to the settlement assignee. Empty sends only to people on the report.
CUSTOMER_CONTACT_ACCOUNTS_MAILBOX=
# New web origin for links inside Customer Contact mail. Empty omits the links.
# The path is /customer-contacts/{publicId}. Do not point this at the legacy site.
CUSTOMER_CONTACT_WEB_BASE_URL=
# Graph sendMail mailbox. Mail stays off until CUSTOMER_CONTACT_EMAIL_ENABLED
# is true and this mailbox is set. Uses GRAPH_TENANT_ID, GRAPH_CLIENT_ID and
# GRAPH_CLIENT_SECRET. A failed send does not undo the Customer Contact change.
CUSTOMER_CONTACT_MAIL_FROM=
CUSTOMER_CONTACT_EMAIL_ENABLED=false
# Local browser harness only. Default false. Refuses to start when APP_ENV=production
# or USER_REPOSITORY=azure-sql, and never selects the Azure Customer Contact repository.
# Data lives under the system temp directory (tricab-dev-customer-contact-e2e), not Azure.
CUSTOMER_CONTACT_E2E_MODE=false

# ---------------------------------------------------------------------------
# TriExpense (Phase 5) — notifications and assistive OCR
# ---------------------------------------------------------------------------
# Email uses the shared Graph client-credentials app (GRAPH_TENANT_ID /
# GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET above) but sends as its own mailbox.
# TRIEXPENSE_EMAIL_ENABLED is false everywhere by default: with it off the
# notification adapter resolves recipients and logs the intent without calling
# Graph, so a deploy can never surprise employees with mail.
TRIEXPENSE_MAIL_FROM=ap@tricab.com
TRIEXPENSE_EMAIL_ENABLED=false
# When set, every recipient is replaced by this address. Use it for any
# non-production run that has real Graph credentials.
TRIEXPENSE_EMAIL_TEST_RECIPIENT=

# Onboarding reminder digests (bin/onboarding-send-reminders.php). OFF unless
# exactly "on". Outside production a run also needs a test recipient (every
# reminder goes there) or GUEST_EMAIL_PROVIDER=development, or it sends nothing.
ONBOARDING_REMINDER_EMAILS=
ONBOARDING_EMAIL_TEST_RECIPIENT=
# Base URL used to build receipt deep links in emails. Empty omits the link.
TRIEXPENSE_APP_BASE_URL=
TRIEXPENSE_GRAPH_CONNECT_TIMEOUT_SECONDS=5
TRIEXPENSE_GRAPH_REQUEST_TIMEOUT_SECONDS=15

# OCR is assistive only — suggestions are returned to the client and never
# written onto a receipt. Document Intelligence is required; the OpenAI
# deployment is optional normalisation on top of it.
TRIEXPENSE_OCR_ENABLED=false
TRIEXPENSE_DOC_INTEL_ENDPOINT=
TRIEXPENSE_DOC_INTEL_KEY=
TRIEXPENSE_OPENAI_ENDPOINT=
TRIEXPENSE_OPENAI_KEY=
TRIEXPENSE_OPENAI_DEPLOYMENT=gpt-4o-mini
TRIEXPENSE_OCR_CONNECT_TIMEOUT_SECONDS=5
TRIEXPENSE_OCR_REQUEST_TIMEOUT_SECONDS=30

# Authorization cutover: legacy | hybrid | permissions (default hybrid).
# legacy = ExpenseProfile.IsFinance / IsExpenseAdmin only
# permissions = TRIEXPENSE.* permissions authoritative
# hybrid = OR of both; mismatches logged
TRIEXPENSE_PERMISSION_MODE=hybrid
# Cutover rehearsal: set to permissions after MISMATCH unexplained=0.
# Rollback options: legacy | hybrid
# TRIEXPENSE_PERMISSION_MODE=permissions

# Generic legacy TriExpense read-only bridge (MySQL SELECT only).
# Recommended: non-prod true; production false until validated.
TRIEXPENSE_LEGACY_READ_ENABLED=false

# Quotes & Orders Phase 1 — read-only search/detail over legacy tc MySQL
# (tqoth/tqoti/tqote/customer_orders). Requires LEGACY_TC_* configured.
# Default false; enable only when the RO bridge is available.
QUOTES_ORDERS_LEGACY_READ_ENABLED=false

# Quotes & Orders Phase 4B/4C — DISABLED legacy write repository (no HTTP routes).
# Default false. Must NOT reuse LEGACY_TC_* RO credentials.
# Dedicated non-prod MySQL writer identity only. Provision outside git; store in local
# .env and/or non-prod App Service application settings.
# Preferred: migration/admin identity for DDL; runtime writer for SELECT/INSERT/UPDATE.
# Runtime GRANT scope (non-prod _dev only):
#   tqoth_dev: SELECT, INSERT, UPDATE
#   tqoti_dev: SELECT, INSERT
#   tqote_dev: SELECT, INSERT
#   quote_write_correlation_dev: SELECT, INSERT
# When enabling Phase 4C controlled write: ENABLED=true + TABLE_SUFFIX=_dev.
QUOTES_ORDERS_LEGACY_WRITE_ENABLED=false
# Either DSN form:
# QUOTES_ORDERS_LEGACY_WRITE_DSN=mysql:host=...;port=3306;dbname=tc;charset=utf8mb4
# Or parts:
# QUOTES_ORDERS_LEGACY_WRITE_HOST=
# QUOTES_ORDERS_LEGACY_WRITE_PORT=3306
# QUOTES_ORDERS_LEGACY_WRITE_DATABASE=tc
# QUOTES_ORDERS_LEGACY_WRITE_USER=
# QUOTES_ORDERS_LEGACY_WRITE_PASSWORD=
# QUOTES_ORDERS_LEGACY_WRITE_SSL_MODE=required
# QUOTES_ORDERS_LEGACY_WRITE_TABLE_SUFFIX=_dev

# ---------------------------------------------------------------------------
# Finance (Tri-Task, Tri-Credit Notes, Argo Collect, Tri-AR, Tri-AP)
# ---------------------------------------------------------------------------
# All off by default. Off: nothing under /api/v1/finance is registered. An app
# switch has no effect while FINANCE_MODULE_ENABLED is off. /api/v1/me reports
# modules.finance only when the module is on AND the caller holds FINANCE.ACCESS.
FINANCE_MODULE_ENABLED=false
FINANCE_TASK_ENABLED=false
FINANCE_CREDIT_ENABLED=false
FINANCE_COLLECT_ENABLED=false
FINANCE_AR_ENABLED=false
FINANCE_AP_ENABLED=false
# Tri-Task decides "today" and "overdue" (and the 08:00 daily summary) in this time zone.
FINANCE_TASK_TIMEZONE=Australia/Melbourne
# The mailbox Tri-Task's daily summary is sent from, and the From suggested in its email dialogs. Empty by
# default: no fallback, so an unconfigured server sends no summary. It must hold a Tri-Task send grant in
# finance.mailbox_grants. The value is set by whoever runs the server.
FINANCE_TASK_MAIL_FROM=
# Each preparer's own 08:00 email of their overdue and due-today tasks (task.preparer-digest). Off by default, so
# turning it on is a decision: tell the team first. Needs Tri-Task on and FINANCE_TASK_MAIL_FROM.
FINANCE_TASK_PREPARER_DIGEST_ENABLED=false
# A reminder or task email is sent from the signed-in person's own address and no other (the daily summary and the
# automatic notices still use FINANCE_TASK_MAIL_FROM). Graph sends it with the finance app's Mail.Send, so an Exchange
# application access policy that limits the app to shared mailboxes makes these sends fail; false goes back to the
# shared mailboxes with a Tri-Task send grant.
FINANCE_TASK_SEND_AS_USER=true
# Tri-AR decides "today", "overdue" and the register's local-day filters in this time zone.
FINANCE_AR_TIMEZONE=Australia/Melbourne
# The mailbox Tri-AR reads and shows in its header. Defaults to ar@tricab.com when empty.
FINANCE_AR_MAILBOX=
# Where the "Tri-Credit Notes" link in Tri-AR's sidebar goes while that app is still on AWS. Empty hides the link.
FINANCE_AR_CREDIT_NOTES_URL=
# Tri-AR's send routes (the reply composer, credit-note mail, overdue reminders) are refused with a 503 unless this is
# true. It stays false until the switch-over (FINANCE-PHASE-5.md, Q15): two systems must never reply to customers.
# It is separate from FINANCE_MAIL_ENABLED, which switches the shared mail service itself.
FINANCE_AR_SENDING_ENABLED=false
# The web address credit-note form links are built from, e.g. https://tricab.ai (an origin: https, no path; http only for
# localhost). Empty by default: with it empty, creating or resending a credit-note request is refused rather than mailing
# a rep a link that cannot work. How long a link lives, in hours (1 to 720):
FINANCE_AR_PUBLIC_ORIGIN=
FINANCE_AR_FORM_LINK_HOURS=72
# Local development only: loads Tri-AR's five invented sample PDFs (the files behind seed-finance-ar-sample-local.sql) into
# the in-memory blob store, which forgets between requests. Refused when APP_ENV=production or BLOB_AUTH_MODE is not
# memory or disabled.
FINANCE_AR_SAMPLE_FILES=false
# Tri-AP decides "today" and "overdue" and the register's local-day filters in this time zone (question Q3).
FINANCE_AP_TIMEZONE=Australia/Melbourne
# Tri-AP's own mailbox: the default address its vendor email, replies and approval mail are sent from. It still needs an
# AP send grant in the finance mailbox registry.
FINANCE_AP_MAILBOX=ap@tricab.com
# The origin the link in Tri-AP's approval mail is built from, such as https://tricab.ai (https, no path). Empty uses
# PASSKEY_PUBLIC_APP_BASE_URL.
FINANCE_AP_PUBLIC_ORIGIN=
# Tri-AP's send routes (vendor email, replies, approval mail) are refused or skipped unless this is true. It stays false
# until the switch-over (FINANCE-PHASE-6.md, D79, D80): two systems must never mail vendors or approvers twice. It is
# separate from FINANCE_MAIL_ENABLED, which switches the shared mail service itself.
FINANCE_AP_SENDING_ENABLED=false
# Tri-AP asks the model for a first-draft reply to every scanned email unless this is 0, false or no (any case). Unset or
# empty is on. Switching it off saves one model call per email; it changes no other behaviour.
FINANCE_AP_SUGGEST_REPLIES=true
# A model-read invoice below this confidence (0 to 1; strictly below) is held as Needs Review. The source's value, 0.80.
FINANCE_AP_CONFIDENCE_THRESHOLD=0.80
# Optional comma list of our own mail domains (with or without a leading @). An address on one of them is never taken as a
# vendor's address, so a forwarded invoice does not make the forwarder the vendor. Empty: the AP mailbox's own domain.
FINANCE_AP_INTERNAL_EMAIL_DOMAINS=
# The mailbox scan (T6.7) reads a PDF whatever its size, but skips any other attachment (a PNG, JPEG or TIFF) smaller than this
# many bytes: signature logos and tracking pixels. The source's value, 25600.
FINANCE_AP_MIN_ATTACHMENT_BYTES=25600
# The most messages the scan lists from one mailbox in one run, newest first. 0 is no cap (the source's default): the period the
# person picks is the limit.
FINANCE_AP_MAX_SCAN_MESSAGES=0
# Local development only: loads Tri-AP's invented sample invoice documents (the files behind seed-finance-ap-sample-local.sql) into
# the in-memory blob store, which forgets between requests. Refused when APP_ENV=production or BLOB_AUTH_MODE is not
# memory or disabled.
FINANCE_AP_SAMPLE_FILES=false
# Finance mail (F1.4): a send from a shared mailbox, through the finance apps' own
# Graph registration (not the platform's GRAPH_* above). Off by default. Off, or with
# any of the three Graph settings empty, a send makes no network call and leaves a
# `suppressed` ledger row saying mail is switched off; sending that key again later
# is not a conflict. Set the values on tc-web and in
# the local .env yourself; they are never in the repository.
# FINANCE_MAIL_TEST_RECIPIENT, when set, redirects every send to that address.
FINANCE_MAIL_ENABLED=false
FINANCE_MAIL_TEST_RECIPIENT=
FINANCE_GRAPH_TENANT_ID=
FINANCE_GRAPH_CLIENT_ID=
FINANCE_GRAPH_CLIENT_SECRET=
# Finance mailbox reading (F1.11) is a separate switch from sending: it needs the same registration
# to hold admin-consented Mail.Read. Off, or on with any of the three FINANCE_GRAPH_* settings empty,
# every read refuses ("switched off") and nothing reads a mailbox. Values are set by Manusha.
FINANCE_MAILBOX_READ_ENABLED=false
# ---------------------------------------------------------------------------
# Mail review inbox (/inbox, /api/v1/mail). Off by default. Off: nothing under /api/v1/mail is registered
# and /api/v1/me reports modules.inbox false. On, /api/v1/me reports modules.inbox only for someone holding
# MAIL.ACCESS. The list, labels and previews come from the database; a message's BODY and its attachments
# are fetched from Exchange when someone opens them, through the RFQ mail Graph registration below (RFQ M0:
# its own app registration with admin-consented Mail.Read, scoped to melbourne@ only, apart from the
# platform's GRAPH_* and from FINANCE_GRAPH_*). While any of the three is empty, opening a body or a file
# answers 503 and reads nothing. Values are set on tc-web and in the local .env by Manusha; never in the repository.
# ---------------------------------------------------------------------------
MAIL_MODULE_ENABLED=false
RFQ_MAIL_GRAPH_TENANT_ID=
RFQ_MAIL_GRAPH_CLIENT_ID=
RFQ_MAIL_GRAPH_CLIENT_SECRET=
# ---------------------------------------------------------------------------
# RFQ mail reader (RFQ plan M3) and classifier (M4): the `rfq-mail` WebJob and bin/run-rfq-mail-reader.php.
# Everything is off by default and nothing reads Exchange until BOTH switches say go.
#   RFQ_MAIL_READ_ENABLED  the pause switch. false = the job does nothing (it records the mailbox as paused).
#   RFQ_MAIL_MODE          off (default) | shadow | live. shadow classifies and records into [mail]; it creates no
#                          drafts and sends nothing. live behaves as shadow plus a log warning until drafts are
#                          built (M6). off does nothing at all, even with the read switch on.
# The reader uses the RFQ_MAIL_GRAPH_* registration above when all three are set, else the platform's GRAPH_*
# (the RFQ Graph app, ai-rfq-parser-mail, which holds Mail.Read; 19 Oct 2026) and, to classify,
# the platform's FOUNDRY_ENABLED / FOUNDRY_ENDPOINT / FOUNDRY_AUTH_MODE (managed identity) with the deployment below.
# ---------------------------------------------------------------------------
RFQ_MAIL_READ_ENABLED=false
RFQ_MAIL_MODE=off
RFQ_MAIL_MAILBOX=melbourne@tricab.com
# The first pass (no delta token yet) reads from this many days ago, not the whole mailbox.
RFQ_MAIL_FIRST_RUN_DAYS=2
# Delta token, lock and heartbeat state. Relative to the app root unless absolute. A deploy empties it: the
# next pass then starts from RFQ_MAIL_FIRST_RUN_DAYS again, and nothing is recorded twice.
RFQ_MAIL_STATE_PATH=var/rfq-mail
# A pass stops fetching further pages after this many seconds (the next pass resumes where it stopped).
RFQ_MAIL_PASS_SECONDS=100
# While Graph returns nothing the database is not touched (so serverless tc can pause); the mailbox's "last
# sync" is refreshed at most this often.
RFQ_MAIL_HEARTBEAT_MINUTES=360
RFQ_MAIL_CLASSIFIER_MODEL=claude-haiku-5-5
RFQ_MAIL_CLASSIFIER_TIMEOUT_SECONDS=30
# Extra addresses whose mail is ours and never classified (comma list). The mailbox itself is always ours.
RFQ_MAIL_OWN_ADDRESSES=
# Odoo reference lists (F1.12): the platform's own copy of Odoo's companies, vendors, cost centres and
# accounts, read once a day by the finance job runner and on request by a finance administrator. Odoo.sh
# (falinwa-tricab, Odoo 19, JSON-2 API). ODOO_URL must be https. ODOO_COMPANY_IDS is a comma list (2,4).
# ODOO_API_KEY_EXPIRES (yyyy-mm-dd) drives the expiry warning. With any of the first three empty the sync
# refuses and no job is registered. Values are Manusha's; the key is read-only and is never in the repository.
ODOO_URL=
ODOO_API_KEY=
ODOO_COMPANY_IDS=
ODOO_API_KEY_EXPIRES=
# Finance AI (F1.5): the third loopback Python service (core/python/finance_ai, port
# 8003), started by startup.sh only when FINANCE_AI_ENABLED is exactly true (PHP reads it the same way). Enabled
# with an empty token counts as disabled, and the base URL must be loopback. The
# service reads the finance apps' own OpenRouter key from FINANCE_OPENROUTER_API_KEY
# in ITS environment (never the RFQ parser's OPENROUTER_API_KEY); PHP never sees it.
# Set the token and the key on tc-web and locally yourself; neither is in the repository.
FINANCE_AI_ENABLED=false
FINANCE_AI_BASE_URL=http://127.0.0.1:8003
FINANCE_AI_INTERNAL_TOKEN=
FINANCE_OPENROUTER_API_KEY=
# NPR (New Product Request) attachments (N2.3): a private container on the storage connection above (BLOB_*).
# The container must exist; the app does not create it. Limits: 10 MiB a file, 30 MiB and 20 files a request.
NPR_ATTACHMENTS_CONTAINER=npr-attachments
# NPR workflow email (N2.4). off = outbox rows are written as "suppressed" and nothing is sent (default);
# test = every message goes to NPR_MAIL_TEST_RECIPIENT only; live = to the real recipients.
# Sends through Microsoft Graph (the platform GRAPH_* registration) as NPR_MAIL_SENDER, which must be a mailbox
# that registration may send as. The Deputy CEO (copied on the first TSD handoff and the final screening
# outcome only) and the TSD queue address are settings, never code: with either empty, the delivery that needs
# it is recorded as a visible failure.
NPR_MAIL_MODE=off
NPR_MAIL_TEST_RECIPIENT=
NPR_MAIL_SENDER=
NPR_DEPUTY_CEO_EMAIL=
NPR_TSD_QUEUE_EMAIL=
# Links in the mail point here (/npr/..., /npr/team/..., /admin/tsd/npr/...).
NPR_APP_BASE_URL=https://tricab.ai
# The retry sweep (bin/run-npr-mail-sweep.php --if-woken) only looks at the database after a failed send
# writes a wake file here (relative to the app root), so an idle sweep never wakes the serverless tc.
NPR_MAIL_WAKE_PATH=var/npr-mail
# Screening signatories (comma list of emails); empty keeps request-screening and decide blocked.
NPR_SCREENING_SIGNATORY_EMAILS=
