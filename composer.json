{
    "name": "tricab/tricab-api",
    "description": "TriCab Slim API — authentication slice consuming TriCab Core",
    "type": "project",
    "license": "proprietary",
    "require": {
        "dompdf/dompdf": "^3.1",
        "php": "^8.3",
        "firebase/php-jwt": "^6.10",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "tricab/tricab-core": "dev-main",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "core",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "TriCab\\Api\\": "src/",
            "TriCab\\Core\\LegacyMigration\\": "core/src/LegacyMigration/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TriCab\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ],
        "verify-core": "php bin/verify-core-import.php",
        "start": "php -S localhost:8080 -t public public/router.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
