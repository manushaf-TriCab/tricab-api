{
    "name": "tricab/tricab-api",
    "description": "TriCab Slim API \u2014 authentication slice consuming TriCab Core",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "firebase/php-jwt": "^6.10",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "tricab/tricab-core": "dev-main",
        "vlucas/phpdotenv": "^5.6",
        "web-auth/webauthn-lib": "^5.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "core"
        }
    ],
    "autoload": {
        "psr-4": {
            "TriCab\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TriCab\\Api\\Tests\\": "tests/",
            "TriCab\\Core\\Tests\\": "core/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@test",
            "@analyse",
            "@python-test"
        ],
        "verify-core": "php bin/verify-core-import.php",
        "start": "PHP_CLI_SERVER_WORKERS=8 php -S 127.0.0.1:8080 -t public public/router.php",
        "python-test": "python3 -m pytest core/python",
        "python-check": "python3 core/python/tools/check_rules_sync.py"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts-descriptions": {
        "python-test": "Run the product finder and cable-rules pytest suite",
        "python-check": "Check tricab_cable_rules against the RFQ parser (set RFQ_MATCHER_PATH)"
    }
}
