server {
    listen 8080;
    listen [::]:8080;

    root /home/site/wwwroot;
    index index.html;
    server_name _;
    port_in_redirect off;

    # Compression. nginx's default gzip_types is text/html only, so JS, CSS,
    # SVG and the API's JSON went out uncompressed. woff2 and woff are already
    # compressed, and images/video/xlsx/zip are left alone. The streamed
    # assistant route sets `gzip off` itself (text/event-stream is not listed
    # here either, but compression would buffer the stream).
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/csv
        text/xml
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        application/wasm
        image/svg+xml
        font/ttf
        font/otf
        application/vnd.ms-fontobject;

    # Caching headers. No security headers are set anywhere in this file, so
    # the add_header inheritance rule (a location's add_header discards the
    # server-level ones) costs nothing today. If a server-level add_header is
    # ever added, repeat it in each location below that sets Cache-Control.

    location = /api {
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    location ^~ /api/ {
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    # RFQ saves (8 MB) and source documents (20 MB) are the only request bodies
    # over nginx's 1 MB default; the rest of the platform keeps it. The old RFQ
    # app returned 413 on saves above about 175 lines at 1 MB. The RFQ code
    # enforces its own limits below these (docs/rfq-architecture.md §6.2).
    #
    # nginx checks a Content-Length body here, but a chunked body is checked as
    # it is read, in @tricab_api, so it still gets 1 MB. Browsers send
    # Content-Length; a streaming client would be refused, never let through.
    location = /api/v1/rfqs {
        client_max_body_size 25m;
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    location ^~ /api/v1/rfqs/ {
        client_max_body_size 25m;
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    # NPR attachments: the app accepts files up to 10 MiB (NprAttachmentRules),
    # which nginx's 1 MB default refused with a 413 (a 4.3 MB file in production).
    # Only the upload route gets 11m (a file plus multipart overhead); the rest of
    # /api/v1/npr/ keeps 1 MB. The nested regex is needed because a ^~ prefix
    # location skips regex matching, so the upload route cannot sit beside it.
    location ^~ /api/v1/npr/ {
        try_files /__tricab_api_front_controller__ @tricab_api;

        location ~ ^/api/v1/npr/(me|tsd)/requests/[^/]+/attachments$ {
            client_max_body_size 11m;
            try_files /__tricab_api_front_controller__ @tricab_api;
        }
    }

    # Tri-Task's Excel import: the file arrives as base64 in JSON, a third larger
    # than on disk, and the code refuses a file over 5 MB. At 1 MB, sheets over
    # about 750 KB got a 413 from nginx before the code could say why.
    location = /api/v1/finance/task/import {
        client_max_body_size 8m;
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    # The product assistant's streamed reply (text/event-stream). nginx buffers
    # FastCGI output by default, which would hold the whole reply back until the
    # turn ends; PHP also sends X-Accel-Buffering: no, and this makes it explicit.
    location = /api/v1/assistant/messages/stream {
        try_files /__tricab_api_front_controller__ @tricab_api_stream;
    }

    location = /health {
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    location = /health/database {
        try_files /__tricab_api_front_controller__ @tricab_api;
    }

    location @tricab_api {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;

        fastcgi_param HTTP_PROXY "";
        fastcgi_param SCRIPT_FILENAME /home/site/wwwroot/api/index.php;
        fastcgi_param SCRIPT_NAME /api/index.php;
        fastcgi_param DOCUMENT_ROOT /home/site/wwwroot;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param QUERY_STRING $query_string;
        # PHP's body limits, just above nginx's 25 MB RFQ allowance. They must
        # arrive this way: PHP rejects an oversized body before it reads a
        # .user.ini, and the image's php.ini is not ours to ship. nginx is the
        # per-route gate, so the rest of the API still stops at 1 MB there.
        fastcgi_param PHP_VALUE "post_max_size=26M
upload_max_filesize=20M";

        fastcgi_intercept_errors off;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 3600;
        fastcgi_read_timeout 3600;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
    }

    # @tricab_api with buffering and compression off, for the streamed route above.
    # A named location inherits nothing from the one that jumped to it, so the
    # FastCGI settings are repeated rather than shared.
    location @tricab_api_stream {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;

        fastcgi_param HTTP_PROXY "";
        fastcgi_param SCRIPT_FILENAME /home/site/wwwroot/api/index.php;
        fastcgi_param SCRIPT_NAME /api/index.php;
        fastcgi_param DOCUMENT_ROOT /home/site/wwwroot;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param QUERY_STRING $query_string;

        fastcgi_intercept_errors off;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 3600;
        fastcgi_read_timeout 3600;
        fastcgi_buffering off;
        gzip off;
    }

    location = /app {
        deny all;
    }

    location ^~ /app/ {
        deny all;
    }

    location = /default {
        deny all;
    }

    # Both of these sit at the web root because the App Service reads them from
    # there. `location /` falls through to try_files, so without this they are
    # served as static files — the startup script names the venv path, the log
    # directory and the finder's bind address.
    location = /startup.sh {
        deny all;
    }

    location ~ [^/]\.php(?:/|$) {
        return 404;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location = /auth-redirect.html {
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
    }

    # The SPA shell. It names the hashed bundles, so it must be revalidated on
    # every load or a visitor keeps pointing at chunks the last deploy deleted.
    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /auth-logout-complete.html {
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
    }

    # About / Technical / catalogue static media. Must NOT fall through to the
    # Vite SPA — clients expect image Content-Types, not index.html.
    location ^~ /media/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # These cache headers omit `always` on purpose: a 404 must never carry a
    # year-long immutable header into a browser or CDN cache.
    #
    # Vite output. A missing file here must be a real 404: falling through to
    # index.html returned 200 HTML for a deleted chunk, and a tab opened before
    # a deploy then failed its dynamic import and went blank.
    # The nested regex is the hashed bundle (name-<8 chars>.ext, Vite's
    # default), immutable for a year. The same directory also holds unhashed
    # images and mp4s copied from public/assets, which get a day. (A ^~ prefix
    # skips regex matching, so the regex has to sit inside it.)
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";

        location ~ "^/assets/.+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css|woff2?|svg|png|jpe?g|webp|avif|gif|ico|mp4|webm|json|wasm)$" {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }

    # Unhashed files copied from the web repo's public/ (not under /assets/).
    location ^~ /videos/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    location ^~ /certificates/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    location ^~ /finance-files/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    location ~ ^/(?:favicon\.(?:png|svg)|apple-touch-icon\.png|icons\.svg)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    # SPA fallback: always revalidate, same as index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
